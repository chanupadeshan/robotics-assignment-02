<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="maze">

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.95 0.97 1 1</background>
    </scene>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 -0.3 -1</direction>
    </light>

    <!-- Ground -->
    <model name="ground">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="ground_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>3.2 3.2 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>3.2 3.2 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="maze_walls">
      <static>true</static>

      <!-- ========================= -->
      <!-- OUTER BOUNDARY WALLS      -->
      <!-- ========================= -->

      <!-- Top -->
      <link name="outer_top">
        <pose>0 1.5 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>3.0 0.05 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.0 0.05 0.5</size></box></geometry>
        </visual>
      </link>

      <!-- Bottom -->
      <link name="outer_bottom">
        <pose>0 -1.5 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>3.0 0.05 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.0 0.05 0.5</size></box></geometry>
        </visual>
      </link>

      <!-- Left -->
      <link name="outer_left">
        <pose>-1.5 0 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.05 3.0 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 3.0 0.5</size></box></geometry>
        </visual>
      </link>

      <!-- Right -->
      <link name="outer_right">
        <pose>1.5 0 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.05 3.0 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 3.0 0.5</size></box></geometry>
        </visual>
      </link>

      <!-- ========================= -->
      <!-- INTERNAL WALLS            -->
      <!-- Based on the assignment   -->
      <!-- 6x6 grid, 0.5m spacing    -->
      <!-- ========================= -->

      <!-- Vertical segments -->

      <!-- x = -1.0 , y: 1.0 to 1.5 -->
      <link name="v1">
        <pose>-1.0 1.25 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.05 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.5 0.5</size></box></geometry>
        </visual>
      </link>

      <!-- x = -1.0 , y: -0.5 to 1.0 -->
      <link name="v2">
        <pose>-1.0 0.25 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.05 1.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 1.5 0.5</size></box></geometry>
        </visual>
      </link>

      <!-- x = -0.5 , y: 1.0 to 1.5 -->
      <link name="v3">
        <pose>-0.5 1.25 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.05 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.5 0.5</size></box></geometry>
        </visual>
      </link>

      <!-- x = -0.5 , y: 0.0 to 0.5 -->
      <link name="v4">
        <pose>-0.5 0.25 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.05 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.5 0.5</size></box></geometry>
        </visual>
      </link>

      <!-- x = 0.0 , y: 0.5 to 1.0 -->
      <link name="v5">
        <pose>0.0 0.75 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.05 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.5 0.5</size></box></geometry>
        </visual>
      </link>

      <!-- x = 0.0 , y: -0.5 to 0.0 -->
      <link name="v6">
        <pose>0.0 -0.25 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.05 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.5 0.5</size></box></geometry>
        </visual>
      </link>

      <!-- x = 0.5 , y: 1.0 to 1.5 -->
      <link name="v7">
        <pose>0.5 1.25 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.05 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.5 0.5</size></box></geometry>
        </visual>
      </link>

      <!-- x = 0.5 , y: 0.0 to 0.5 -->
      <link name="v8">
        <pose>0.5 0.25 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.05 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.5 0.5</size></box></geometry>
        </visual>
      </link>

      <!-- x = 1.0 , y: 0.5 to 1.0 -->
      <link name="v9">
        <pose>1.0 0.75 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.05 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.5 0.5</size></box></geometry>
        </visual>
      </link>

      <!-- x = 1.0 , y: -1.0 to 0.0 -->
      <link name="v10">
        <pose>1.0 -0.5 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.05 1.0 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 1.0 0.5</size></box></geometry>
        </visual>
      </link>

      <!-- Horizontal segments -->

      <!-- y = 1.0 , x: -1.5 to -1.0 -->
      <link name="h1">
        <pose>-1.25 1.0 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.5 0.05 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.05 0.5</size></box></geometry>
        </visual>
      </link>

      <!-- y = 0.5 , x: -0.5 to 0.5 -->
      <link name="h2">
        <pose>0.0 0.5 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.0 0.05 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.05 0.5</size></box></geometry>
        </visual>
      </link>

      <!-- y = 0.5 , x: 0.5 to 1.0 -->
      <link name="h3">
        <pose>0.75 0.5 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.5 0.05 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.05 0.5</size></box></geometry>
        </visual>
      </link>

      <!-- y = 0.0 , x: 0.5 to 1.5 -->
      <link name="h4">
        <pose>1.0 0.0 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.0 0.05 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.05 0.5</size></box></geometry>
        </visual>
      </link>

      <!-- y = -0.5 , x: -1.0 to 0.0 -->
      <link name="h5">
        <pose>-0.5 -0.5 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.0 0.05 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.05 0.5</size></box></geometry>
        </visual>
      </link>

      <!-- y = -0.5 , x: 0.0 to 0.5 -->
      <link name="h6">
        <pose>0.25 -0.5 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.5 0.05 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.05 0.5</size></box></geometry>
        </visual>
      </link>

      <!-- y = -1.0 , x: -1.5 to -1.0 -->
      <link name="h7">
        <pose>-1.25 -1.0 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.5 0.05 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.05 0.5</size></box></geometry>
        </visual>
      </link>

      <!-- y = -1.0 , x: -0.5 to 1.0 -->
      <link name="h8">
        <pose>0.25 -1.0 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.5 0.05 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.05 0.5</size></box></geometry>
        </visual>
      </link>

    </model>

  </world>
</sdf>
